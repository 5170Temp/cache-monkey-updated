{
  "name": "cache-monkey",
  "version": "1.0.8",
  "description": "Ah thats hot.",
  "author": "Jamie Pine and 5170",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/5170Temp" },
  "main": "src/main/index.js",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k \"webpack serve --config webpack.renderer.config.cjs --mode development\" \"wait-on http://localhost:9080 && cross-env NODE_ENV=development electron .\"",
    "pack": "webpack --config webpack.renderer.config.cjs --mode production",
    "build": "npm run pack && electron-builder build -p never",
    "build:win": "npm run pack && electron-builder build -w --x64 -p never",
    "build:osx": "npm run pack && electron-builder build -m -p never",
    "build:lin": "npm run pack && electron-builder build -l --x64 -p never",
    "build:dir": "npm run pack && electron-builder --dir",
    "lint": "eslint src test webpack.renderer.config.cjs",
    "lint:fix": "eslint --fix src test webpack.renderer.config.cjs"
  },
  "build": {
    "productName": "CacheMonkey",
    "appId": "com.jamiepine.cachemonkey",
    "directories": { "output": "build" },
    "files": ["dist/electron/**/*", "src/main/index.js"],
    "asarUnpack": ["**/node_modules/@ffmpeg-installer/**/ffmpeg*"],
    "publish": [{ "provider": "github", "owner": "jamiepine", "repo": "cache-monkey" }],
    "mac": { "icon": "build/icons/icon.icns" },
    "win": { "icon": "build/icons/icon.ico" },
    "linux": { "target": ["AppImage", "deb", "snap"], "maintainer": "AlekEagle", "category": "Utility", "icon": "build/icons" }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "electron-updater": "^6.8.9",
    "moment": "^2.31.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tippy": "^6.8.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.11.1",
    "html-webpack-plugin": "^5.6.8",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "wait-on": "^9.0.4"
  }
}
